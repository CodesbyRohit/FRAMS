# Copy to server/.env (never commit the real file).
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/frams

# Required. At least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# IANA time zone used to decide which calendar day a scan belongs to.
FRAMS_TIMEZONE=Asia/Kolkata

# Creates admin/faculty/student@frams.edu with publicly known passwords.
# Local demos only. Never enable with real people's data.
FRAMS_SEED_DEMO=false

# Optional tuning
# LOGIN_RATE_LIMIT=10      # attempts per 15 min per IP+email
# VERIFY_RATE_LIMIT=60     # verifications per minute per kiosk session
# TRUST_PROXY=1            # when running behind a reverse proxy
