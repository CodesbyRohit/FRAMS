# ─── ANIMA web environment template ─────────────────────────────────────────
# Copy to .env.local for local development, or set in Vercel project settings
# for production/preview deployments.
#
# NOTE: NEXT_PUBLIC_* variables are inlined into the browser bundle at build
# time. They must exist (or have a sensible fallback) during `next build`.

# Base URL of the ANIMA GraphQL API (services/api).
# The code falls back to http://localhost:4000 when unset.
NEXT_PUBLIC_API_URL=http://localhost:4000
