# ─── ANIMA shared environment template ──────────────────────────────────────
# Copy to .env at the repo root (or into each service) and fill in values.

# --- API (services/api) ---
ANIMA_API_PORT=4000
ANIMA_API_PUBLIC_URL=http://localhost:4000
ANIMA_JWT_SECRET=change-me-to-a-64-char-random-secret
ANIMA_JWT_EXPIRES_IN=8h
ANIMA_SESSION_TTL_SECONDS=28800

# --- Databases / infra ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=anima
POSTGRES_PASSWORD=anima
POSTGRES_DB=anima

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=anima-neo4j

REDIS_URL=redis://localhost:6379

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Trust Service (services/trust, Python) ---
TRUST_SERVICE_URL=http://localhost:8090
TRUST_SERVICE_TOKEN=anima-trust-local
# Path to dlib shape predictor for liveness landmarks (optional; falls back to 68-point face_recognition landmarks)
DLIB_PREDICTOR_PATH=

# --- LLM / embeddings (OpenAI-compatible endpoints) ---
# Works with OpenAI, Azure OpenAI, Groq, Ollama (http://localhost:11434/v1), LM Studio, etc.
ANIMA_LLM_BASE_URL=https://api.openai.com/v1
ANIMA_LLM_API_KEY=sk-...
ANIMA_LLM_MODEL=gpt-4o-mini
ANIMA_EMBEDDING_MODEL=text-embedding-3-small
ANIMA_LLM_TIMEOUT_MS=30000

# --- Web (services/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
